---
layout: layouts/base.njk
stylesheets:
  - assets/case-study.css
footerStyle: simple
---
{# Password gate: rendered after the hero (see below), not as an overlay. #}

{# ── Hero ─────────────────────────────────────────────────────────────── #}
<div class="cs-hero">
  <div class="cs-breadcrumb">{{ breadcrumb }}</div>
  <div class="cs-hero-inner">
    <div>
      <div class="cs-tags">
        {#- `tags` also carries the collection tag from case-studies.11tydata.js; never show that one #}
        {%- for tag in tags | without('case_studies') %}
        <span class="tag {{ 'tag-accent' if loop.first else 'tag-default' }}">{{ tag }}</span>
        {%- endfor %}
      </div>
      <h1 class="cs-title">{{ title }}</h1>
      <p class="cs-subtitle">{{ subtitle }}</p>
    </div>
    <div class="cs-meta-grid">
      {%- for m in meta %}
      <div>
        <div class="cs-meta-label">{{ m.label }}</div>
        <div class="cs-meta-value">{{ m.value | replace("\n", "<br>") | safe }}</div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>

{%- if gated %}
{# ── Password gate ────────────────────────────────────────────────────── #}
{# Sits under the hero so the nav, title, tags and meta stay visible. The
   rest of the page is in .cs-locked and hidden until unlocked. A recruiter
   can be sent a one-click link: <page>.html#access=<password>. #}
<div class="cs-gate" id="cs-gate">
  <div class="cs-gate-inner">
    <div class="cs-gate-label">Password protected</div>
    <h2 class="cs-gate-title">This case study is shared on request</h2>
    <p class="cs-gate-text">It covers client work, so it sits behind a password. If you&rsquo;re hiring or reviewing my work, email me and I&rsquo;ll send it straight back &mdash; or enter the password if you already have it.</p>
    <form class="cs-gate-form" id="cs-gate-form" autocomplete="off">
      <label class="cs-gate-sr" for="pw-input">Password</label>
      <input id="pw-input" type="password" placeholder="Password" autocomplete="off">
      <button class="btn-primary" type="submit">Enter</button>
      <a class="btn-secondary" href="mailto:{{ site.email }}?subject={{ ('Portfolio access — ' + title) | urlencode }}">Email for access</a>
    </form>
    <div class="cs-gate-error" id="pw-error" role="alert" hidden>That password didn&rsquo;t match &mdash; try again, or email me.</div>
  </div>
</div>
{%- endif %}

<div class="cs-locked"{% if gated %} hidden{% endif %}>
{# ── Hero image ───────────────────────────────────────────────────────── #}
<div class="cs-hero-image">
  {%- if hero_html %}
  {{ hero_html | safe }}
  {%- elif hero_image %}
  <img class="cs-hero-media" src="{{ hero_image }}" alt="{{ hero_caption or title }}">
  {%- else %}
  <div class="img-ph-lg"></div>
  {%- endif %}
</div>
{%- if hero_caption %}
<div class="cs-image-caption" style="max-width:var(--content-width);margin:0 auto;padding:0 64px;">{{ hero_caption }}</div>
{%- endif %}

<div class="cs-content">

  {# ── Overview strip ───────────────────────────────────────────────── #}
  {%- if overview %}
  <div style="border-bottom: 1px solid var(--grey-5);">
    <div class="cs-overview" style="border:none; border-bottom:none; margin:0;">
      <div class="overview-cell">
        <div class="overview-cell-label">The Challenge</div>
        <div class="overview-cell-text">{{ overview.challenge }}</div>
      </div>
      <div class="overview-cell">
        <div class="overview-cell-label">The Approach</div>
        <div class="overview-cell-text">{{ overview.approach }}</div>
      </div>
      <div class="overview-cell">
        <div class="overview-cell-label">The Outcome</div>
        <div class="overview-cell-text">{{ overview.outcome }}</div>
      </div>
    </div>
  </div>
  {%- endif %}

  {{ content | csSections | safe }}

</div><!-- /cs-content -->

{# ── Next project ─────────────────────────────────────────────────────── #}
{%- set nextCs = collections.case_studies | bySlug(next) %}
<div class="cs-next">
  <div>
    {%- if nextCs %}
    <div class="cs-next-label">Next Project</div>
    <div class="cs-next-title">{{ nextCs.data.title }}</div>
    {%- else %}
    <div class="cs-next-label">More work</div>
    <div class="cs-next-title">See everything</div>
    {%- endif %}
  </div>
  <div style="display:flex;gap:16px;">
    {%- if nextCs %}
    <a class="btn-primary" href="{{ nextCs.url | replace('/', '') }}">View Project &rarr;</a>
    {%- endif %}
    <a class="btn-secondary" href="index.html">&larr; All Work</a>
  </div>
</div>
</div><!-- /cs-locked -->
{%- if gated %}
{# Runs after .cs-locked exists: the #access= and returning-visitor unlocks need it. #}
<script>
  (function () {
    var gate = document.getElementById('cs-gate');
    var form = document.getElementById('cs-gate-form');
    var input = document.getElementById('pw-input');
    var error = document.getElementById('pw-error');
    var PASSWORD = {{ site.case_study_password | dump | safe }};
    var store = {
      get: function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } },
      set: function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
    };
    function unlock() {
      store.set('cs-unlocked', 'yes');
      gate.hidden = true;
      error.hidden = true;
      var locked = document.querySelector('.cs-locked');
      if (locked) locked.hidden = false;
    }
    // Direct link: #access=<password> unlocks and clears itself from the URL.
    var m = /(?:^#|&)access=([^&]+)/.exec(location.hash);
    if (m && decodeURIComponent(m[1]) === PASSWORD) {
      unlock();
      history.replaceState(null, '', location.pathname + location.search);
    } else if (store.get('cs-unlocked') === 'yes') {
      unlock();
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (input.value === PASSWORD) { unlock(); return; }
      error.hidden = false;
      input.value = '';
      input.focus();
    });
  })();
</script>
{%- endif %}
